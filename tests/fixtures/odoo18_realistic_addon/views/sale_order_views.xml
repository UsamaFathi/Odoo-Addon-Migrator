<odoo>
    <record id="realistic_sale_order_view" model="ir.ui.view">
        <field name="name">realistic.sale.order.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="legacy_note"/>
            </xpath>
        </field>
    </record>
</odoo>
